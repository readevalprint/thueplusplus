FROM golang:1.24.6-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    less \
    make \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    sudo \
    tree \
    vim \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh \
    | env INSTALLER_NO_MODIFY_PATH=1 sh -s -- --no-modify-path \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

RUN go install golang.org/x/tools/gopls@v0.17.1 \
    && go install golang.org/x/tools/cmd/goimports@v0.28.0

RUN useradd -m -s /bin/bash dev \
    && usermod -a -G sudo dev \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers \
    && mkdir -p /workspaces \
    && chown -R dev:dev /workspaces

WORKDIR /workspaces

USER dev

ENV GOPATH=/home/dev/go
ENV PATH="/go/bin:${GOPATH}/bin:${PATH}"
ENV LESSCHARSET=utf-8

RUN git config --global --add safe.directory '*'

CMD ["sh"]
