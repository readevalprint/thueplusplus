^$ ::- 0
^in\n?$ ::< 30 stdin
^(?<n>0|[1-9][0-9]*)\n?$ ::= k:{{n}} a:1
^k:0 a:(?<a>0|[1-9][0-9]*)\n?$ ::= say:{{a}}
^say:(?<a>0|[1-9][0-9]*)\n?$ ::> stdout {{a}}\n
^k:(?<k>[1-9][0-9]*) a:(?<a>0|[1-9][0-9]*)\n?$ ::= k:@SUB[{{k}},1]@ a:@MUL[{{k}},{{a}}]@
@SUB\[(?<k>0|[1-9][0-9]*),(?<one>1)\]@ ::! sub k one
@MUL\[(?<k>0|[1-9][0-9]*),(?<a>0|[1-9][0-9]*)\]@ ::! mul k a

::=
in
