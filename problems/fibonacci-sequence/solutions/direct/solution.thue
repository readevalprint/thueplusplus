^say:(?<a>0|[1-9][0-9]*)\n?$ ::> stdout {{a}}\n
^$ ::- 0
^in\n?$ ::< 30 stdin
^(?<n>0|[1-9][0-9]*)\n?$ ::= i:0 a:0 b:1 n:{{n}}
^i:(?<i>0|[1-9][0-9]*) a:(?<a>0|[1-9][0-9]*) b:(?<b>0|[1-9][0-9]*) n:(?<n>0|[1-9][0-9]*)\n?$ ::| ^i:{{n}} a: ::= say:{{a}}
^i:(?<i>0|[1-9][0-9]*) a:(?<a>0|[1-9][0-9]*) b:(?<b>0|[1-9][0-9]*) n:(?<n>0|[1-9][0-9]*)\n?$ ::= i:@ADD[{{i}},1]@ a:{{b}} b:@ADD[{{a}},{{b}}]@ n:{{n}}
@ADD\[(?<x>0|[1-9][0-9]*),(?<y>0|[1-9][0-9]*)\]@ ::! add x y

::=
in
