\Aphase:sq\nn:(?<n>0|[1-9][0-9]*)\nd:(?<d>[1-9][0-9]*)\n?\z ::= phase:cmp\nsq:@MUL[{{d}},{{d}}]@\nn:{{n}}\nd:{{d}}
\Aphase:cmp\nsq:(?<sq>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\nd:(?<d>[1-9][0-9]*)\n?\z ::= cmp:@GT[{{sq}},{{n}}]@\nn:{{n}}\nd:{{d}}
\Acmp:1\nn:(?<n>0|[1-9][0-9]*)\nd:(?<d>[1-9][0-9]*)\n?\z ::= yes
\Acmp:0\nn:(?<n>0|[1-9][0-9]*)\nd:(?<d>[1-9][0-9]*)\n?\z ::= phase:mod\nm:@MOD[{{n}},{{d}}]@\nn:{{n}}\nd:{{d}}
