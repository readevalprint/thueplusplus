\Aout:(?<t>FizzBuzz|Fizz|Buzz|0|[1-9][0-9]*)\n ::> stdout {{t}}\n
\Ag:1\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::- 0
\Ag:0\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= go:{{i}}:{{n}}
\Ai:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= next:@ADD[{{i}},1]@:{{n}}
\Anext:(?<i>0|[1-9][0-9]*):(?<n>0|[1-9][0-9]*)\z ::= g:@GT[{{i}},{{n}}]@\ni:{{i}}\nn:{{n}}\n
@GT\[(?<i>0|[1-9][0-9]*),(?<n>0|[1-9][0-9]*)\]@ ::! gt i n
@ADD\[(?<x>0|[1-9][0-9]*),(?<y>0|[1-9][0-9]*)\]@ ::! add x y
\Am3:0\nm5:0\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= out:FizzBuzz\ni:{{i}}\nn:{{n}}\n
\Am3:0\nm5:(?<m>0|[1-9][0-9]*)\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= out:Fizz\ni:{{i}}\nn:{{n}}\n
\Am3:(?<m>0|[1-9][0-9]*)\nm5:0\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= out:Buzz\ni:{{i}}\nn:{{n}}\n
\Am3:(?<a>0|[1-9][0-9]*)\nm5:(?<b>0|[1-9][0-9]*)\ni:(?<i>0|[1-9][0-9]*)\nn:(?<n>0|[1-9][0-9]*)\n\z ::= out:{{i}}\ni:{{i}}\nn:{{n}}\n
\Ago:(?<i>0|[1-9][0-9]*):(?<n>0|[1-9][0-9]*)\z ::= m3:@MOD[{{i}},3]@\nm5:@MOD[{{i}},5]@\ni:{{i}}\nn:{{n}}\n
@MOD\[(?<a>0|[1-9][0-9]*),(?<b>0|[1-9][0-9]*)\]@ ::! mod a b
\Ain\n?\z ::< 30 stdin
\A(?<n>[1-9][0-9]*)\n?\z ::= go:1:{{n}}

::=
in
