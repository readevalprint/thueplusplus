^yes\n?$ ::> stdout true\n
^no\n?$ ::> stdout false\n
^$ ::- 0
\Am400:0\ny:(?<y>0|[1-9][0-9]*)\n?\z ::= yes
\Am100:0\ny:(?<y>0|[1-9][0-9]*)\n?\z ::= no
\Am4:0\n?\z ::= yes
\Am4:(?<m>[1-9][0-9]*)\n?\z ::= no
\Am400:(?<m>[1-9][0-9]*)\ny:(?<y>0|[1-9][0-9]*)\n?\z ::= m100:@MOD[{{y}},100]@\ny:{{y}}
\Am100:(?<m>[1-9][0-9]*)\ny:(?<y>0|[1-9][0-9]*)\n?\z ::= m4:@MOD[{{y}},4]@
\Ay:(?<y>0|[1-9][0-9]*)\n?\z ::= m400:@MOD[{{y}},400]@\ny:{{y}}
@MOD\[(?<y>0|[1-9][0-9]*),(?<m>400|100|4)\]@ ::! mod y m
\Ain\n?\z ::< 30 stdin
\A(?<y>0|[1-9][0-9]*)\n?\z ::= y:{{y}}

::=
in
