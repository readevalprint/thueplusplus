^say:(?<a>0|[1-9][0-9]*)\n?$ ::> stdout {{a}}\n
\A\z ::- 0
\Aa:(?<a>0|[1-9][0-9]*)\nb:0\n?\z ::= say:{{a}}
\Aa:(?<a>0|[1-9][0-9]*)\nb:(?<b>[1-9][0-9]*)\n?\z ::= a:{{b}}\nb:@MOD[{{a}},{{b}}]@
@MOD\[(?<a>0|[1-9][0-9]*),(?<b>[1-9][0-9]*)\]@ ::! mod a b
^read$ ::< 30 stdin
\Aa:(?<a>0|[1-9][0-9]*)\n(?<b>0|[1-9][0-9]*)\n?\z ::= a:{{a}}\nb:{{b}}
\A(?<a>0|[1-9][0-9]*)\n?\z ::= a:{{a}}\nread
\Ain\n?\z ::< 30 stdin

::=
in
