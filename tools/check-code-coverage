#!/usr/bin/env python3
"""Collect host-code coverage for thue++ Python and Go implementations.

This tool intentionally instruments the same external-command path used by the
shared manifest runner. It does not import Python interpreter internals and does
not rely on plain Go package coverage as the Go CLI signal.
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPORT_ROOT = ROOT / "build" / "coverage"
PYTHON_REPORT = REPORT_ROOT / "python" / "coverage.txt"
PYTHON_XML = REPORT_ROOT / "python" / "coverage.xml"
GO_PROFILE = REPORT_ROOT / "go" / "coverage.out"
GO_REPORT = REPORT_ROOT / "go" / "coverage.txt"


class CoverageError(RuntimeError):
    pass


def run(argv: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    display = " ".join(argv)
    print(f"$ {display}")
    completed = subprocess.run(
        argv,
        cwd=cwd,
        env=env,
        text=True,
        capture_output=True,
    )
    if completed.stdout:
        print(completed.stdout, end="")
    if completed.stderr:
        print(completed.stderr, end="", file=sys.stderr)
    if completed.returncode != 0:
        raise CoverageError(f"command failed with exit {completed.returncode}: {display}")
    return completed


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise CoverageError(f"required command not found: {name}")


def require_coverage_import() -> None:
    run(["uv", "run", "python", "-c", "import coverage"])


def fresh_report_dir() -> None:
    if REPORT_ROOT.exists():
        shutil.rmtree(REPORT_ROOT)
    (REPORT_ROOT / "python").mkdir(parents=True)
    (REPORT_ROOT / "go").mkdir(parents=True)


def python_env(data_root: Path) -> dict[str, str]:
    env = os.environ.copy()
    env["COVERAGE_FILE"] = str(data_root / ".coverage")
    return env


def coverage_data_files(data_root: Path) -> list[Path]:
    return sorted(data_root.glob(".coverage*"))


def assert_python_coverage_data(data_root: Path) -> None:
    files = [path for path in coverage_data_files(data_root) if path.is_file() and path.stat().st_size > 0]
    if not files:
        raise CoverageError(f"Python coverage produced no non-empty data files under {data_root}")


def collect_python_unit_coverage(data_root: Path) -> None:
    run(
        [
            "uv",
            "run",
            "coverage",
            "run",
            "--branch",
            "--parallel-mode",
            "--source=python,tools",
            "-m",
            "unittest",
            "discover",
            "-s",
            "python/tests",
            "-v",
        ],
        env=python_env(data_root),
    )
    assert_python_coverage_data(data_root)


def build_go_coverage_binary(artifact: Path) -> None:
    artifact.parent.mkdir(parents=True, exist_ok=True)
    run(
        [
            "go",
            "build",
            "-cover",
            "-coverpkg=./...",
            "-o",
            str(artifact),
            "./cmd/thuepp",
        ],
        cwd=ROOT / "go",
    )
    if not artifact.exists() or artifact.stat().st_size == 0:
        raise CoverageError(f"instrumented Go binary was not created: {artifact}")


def write_coverage_contract(contract_path: Path, python_data_root: Path, go_coverage_dir: Path, go_artifact: Path) -> None:
    contract_path.write_text(
        textwrap.dedent(
            f"""
            [implementations.python]
            available = true
            command = "env COVERAGE_FILE={python_data_root / '.coverage'} uv run coverage run --branch --parallel-mode --source=python python/thuepp.py"
            notes = "Coverage-instrumented Python implementation command generated by tools/check-code-coverage."

            [implementations.go]
            available = true
            command = "env GOCOVERDIR={go_coverage_dir} {go_artifact}"
            notes = "Coverage-instrumented Go implementation command generated by tools/check-code-coverage."
            """
        ).strip()
        + "\n",
        encoding="utf-8",
    )


def collect_shared_manifest_coverage(data_root: Path, go_coverage_dir: Path, go_artifact: Path, tmp: Path) -> None:
    contract_path = tmp / "coverage-contract.toml"
    write_coverage_contract(contract_path, data_root, go_coverage_dir, go_artifact)
    completed = run(
        [
            "uv",
            "run",
            "python",
            "tools/run-example-manifests",
            "--contract",
            str(contract_path),
            "--parity",
            *[str(path) for path in sorted((ROOT / "examples").glob("*/tests/*.toml"))],
        ]
    )
    if "for python, go" not in completed.stdout:
        raise CoverageError("shared manifest coverage run did not execute both Python and Go implementations")
    assert_python_coverage_data(data_root)
    assert_go_coverage_data(go_coverage_dir)


def assert_go_coverage_data(go_coverage_dir: Path) -> None:
    files = [path for path in go_coverage_dir.glob("*") if path.is_file() and path.stat().st_size > 0]
    counter_files = [path for path in files if path.name.startswith("covcounters.")]
    meta_files = [path for path in files if path.name.startswith("covmeta.")]
    if not counter_files or not meta_files:
        raise CoverageError(f"Go coverage data missing covmeta/covcounters files under {go_coverage_dir}")


def write_python_reports(data_root: Path) -> None:
    combined_file = REPORT_ROOT / "python" / ".coverage"
    env = os.environ.copy()
    env["COVERAGE_FILE"] = str(combined_file)
    run(["uv", "run", "coverage", "combine", str(data_root)], env=env)
    if not combined_file.exists() or combined_file.stat().st_size == 0:
        raise CoverageError(f"combined Python coverage file is missing or empty: {combined_file}")
    report = run(["uv", "run", "coverage", "report", "-m"], env=env)
    PYTHON_REPORT.write_text(report.stdout, encoding="utf-8")
    if "TOTAL" not in report.stdout:
        raise CoverageError("Python coverage report is malformed: missing TOTAL line")
    run(["uv", "run", "coverage", "xml", "-o", str(PYTHON_XML)], env=env)
    if not PYTHON_XML.exists() or PYTHON_XML.stat().st_size == 0:
        raise CoverageError(f"Python XML coverage report is missing or empty: {PYTHON_XML}")


def write_go_reports(go_coverage_dir: Path) -> None:
    run(["go", "tool", "covdata", "textfmt", f"-i={go_coverage_dir}", f"-o={GO_PROFILE}"], cwd=ROOT / "go")
    if not GO_PROFILE.exists() or GO_PROFILE.stat().st_size == 0:
        raise CoverageError(f"Go text coverage profile is missing or empty: {GO_PROFILE}")
    report = run(["go", "tool", "cover", f"-func={GO_PROFILE}"], cwd=ROOT / "go")
    GO_REPORT.write_text(report.stdout, encoding="utf-8")
    if "total:" not in report.stdout:
        raise CoverageError("Go coverage report is malformed: missing total line")


def main() -> int:
    try:
        require_command("uv")
        require_command("go")
        require_coverage_import()
        fresh_report_dir()
        with tempfile.TemporaryDirectory(prefix="thuepp-code-coverage-") as tmpdir:
            tmp = Path(tmpdir)
            python_data_root = tmp / "python-data"
            go_coverage_dir = tmp / "go-covdata"
            go_artifact = tmp / "go-thuepp-covered"
            python_data_root.mkdir()
            go_coverage_dir.mkdir()
            collect_python_unit_coverage(python_data_root)
            build_go_coverage_binary(go_artifact)
            collect_shared_manifest_coverage(python_data_root, go_coverage_dir, go_artifact, tmp)
            write_python_reports(python_data_root)
            write_go_reports(go_coverage_dir)
        print(f"Python coverage report: {PYTHON_REPORT.relative_to(ROOT)}")
        print(f"Python coverage XML: {PYTHON_XML.relative_to(ROOT)}")
        print(f"Go coverage profile: {GO_PROFILE.relative_to(ROOT)}")
        print(f"Go coverage report: {GO_REPORT.relative_to(ROOT)}")
        return 0
    except CoverageError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
