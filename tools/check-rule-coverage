#!/usr/bin/env python3
"""Check thue++ rule coverage counts for TOML example cases."""

from __future__ import annotations

import argparse
import importlib.util
import re
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass
from pathlib import Path

from example_runner import Interpreter, expand_cases, load_toml, run_case as run_manifest_case

ROOT = Path(__file__).resolve().parents[1]
PYTHON_IMPLEMENTATION = Interpreter("python", (sys.executable, str(ROOT / "python" / "thuepp.py")))
THUEPP_MODULE = ROOT / "python" / "thuepp.py"


@dataclass(frozen=True)
class RuleSource:
    rule_id: str
    text: str


@dataclass(frozen=True)
class CoverageCase:
    config_path: Path
    case: dict


@dataclass(frozen=True)
class CoverageTarget:
    program: Path
    cases: tuple[CoverageCase, ...]


def rel(path: Path) -> str:
    try:
        return path.resolve().relative_to(ROOT).as_posix()
    except ValueError:
        return path.resolve().as_posix()


def load_thuepp_module():
    spec = importlib.util.spec_from_file_location("thuepp_parser_for_coverage", THUEPP_MODULE)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"could not load {THUEPP_MODULE}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def reject_coverage_ignores(program: Path, seen: set[Path] | None = None) -> None:
    seen = set() if seen is None else seen
    program = program.resolve()
    if program in seen:
        raise RuntimeError(f"cyclic include detected: {program}")
    seen.add(program)
    for line_number, raw_line in enumerate(program.read_text(encoding="utf-8").splitlines(), 1):
        stripped = raw_line.strip()
        if stripped.startswith("@include "):
            include_path = stripped[9:].strip()
            if include_path.startswith('"') and include_path.endswith('"'):
                include_path = include_path[1:-1]
            reject_coverage_ignores(program.parent / include_path, seen)
            continue
        if stripped.startswith("# coverage: ignore"):
            raise RuntimeError(f"{rel(program)}:{line_number}: coverage ignore comments are unsupported; add fixtures or delete the rule")


def source_line_text(source_path: str, line_number: int) -> str:
    lines = Path(source_path).read_text(encoding="utf-8").splitlines()
    if line_number < 1 or line_number > len(lines):
        return ""
    return lines[line_number - 1].strip()


def enumerate_rules(program: Path) -> list[RuleSource]:
    reject_coverage_ignores(program)
    module = load_thuepp_module()
    interpreter = module.ThueppInterpreter()
    interpreter.load_program(str(program))
    rules: list[RuleSource] = []
    for rule in interpreter.rules:
        source = Path(rule.source_path)
        rule_id = f"{rel(source)}:{rule.line_number}"
        rules.append(RuleSource(rule_id, source_line_text(rule.source_path, rule.line_number)))
    return rules


def run_case(config_path: Path, case: dict, tmp: Path) -> Counter[str]:
    coverage_path = tmp / (re.sub(r"[^A-Za-z0-9_.-]+", "_", f"{config_path}:{case.get('name','case')}") + ".tsv")
    run_manifest_case(
        PYTHON_IMPLEMENTATION,
        config_path,
        case,
        tmp,
        extra_args=["--rule-coverage", str(coverage_path)],
    )
    return read_coverage(coverage_path)


def read_coverage(path: Path) -> Counter[str]:
    counts: Counter[str] = Counter()
    if not path.exists():
        raise RuntimeError(f"coverage file was not written: {path}")
    row_re = re.compile(r"^(.+\.tpp:\d+)\t([1-9][0-9]*)$")
    seen = set()
    for row_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        match = row_re.match(line)
        if not match:
            raise RuntimeError(f"{path}:{row_number}: malformed coverage row: {line!r}")
        rule_id, count_text = match.groups()
        if rule_id in seen:
            raise RuntimeError(f"{path}:{row_number}: duplicate coverage row for {rule_id}")
        seen.add(rule_id)
        counts[rule_id] += int(count_text)
    return counts


def check_cases(program: Path, cases: list[CoverageCase]) -> int:
    rules = enumerate_rules(program)
    rule_by_id = {rule.rule_id: rule for rule in rules}
    counts: Counter[str] = Counter()
    with tempfile.TemporaryDirectory(prefix="thuepp-coverage-") as tmpdir:
        tmp = Path(tmpdir)
        for coverage_case in cases:
            counts.update(run_case(coverage_case.config_path, coverage_case.case, tmp))
    unknown = sorted(set(counts) - set(rule_by_id))
    if unknown:
        print("unknown coverage rule IDs:", file=sys.stderr)
        for rule_id in unknown[:50]:
            print(f"  {rule_id}", file=sys.stderr)
        return 1
    uncovered = [rule for rule in rules if counts[rule.rule_id] == 0]
    print(rel(program))
    print(f"  rules:      {len(rules)}")
    print(f"  covered:    {sum(1 for rule in rules if counts[rule.rule_id] > 0)}")
    print(f"  uncovered:  {len(uncovered)}")
    if uncovered:
        print("\nuncovered:")
        for rule in uncovered:
            print(f"  {rule.rule_id}  {rule.text}")
    hottest = counts.most_common(10)
    if hottest:
        print("\nhottest:")
        for rule_id, count in hottest:
            print(f"  {rule_id}\t{count}")
    return 1 if uncovered else 0


def manifest_program(config_path: Path, case: dict) -> Path:
    program = case.get("program")
    if not isinstance(program, str) or not program.strip():
        raise RuntimeError(f"{rel(config_path)} {case.get('name', config_path.stem)!r}: missing program coverage path")
    resolved = (config_path.parent / program).resolve()
    if resolved.suffix != ".tpp":
        raise RuntimeError(f"{rel(config_path)} {case.get('name', config_path.stem)!r}: coverage program must be a .tpp file: {program}")
    if not resolved.exists():
        raise RuntimeError(f"{rel(config_path)} {case.get('name', config_path.stem)!r}: coverage program does not exist: {program}")
    return resolved


def discover_targets(examples_root: Path) -> list[CoverageTarget]:
    targets: dict[Path, list[CoverageCase]] = {}
    examples_root = examples_root.resolve()
    for tests_dir in sorted(examples_root.glob("*/tests")):
        manifests = sorted(tests_dir.glob("*.toml"))
        if not manifests:
            continue
        example_dir = tests_dir.parent.resolve()
        referenced: set[Path] = set()
        for config_path in manifests:
            data = load_toml(config_path)
            for case in expand_cases(data):
                program = manifest_program(config_path, case)
                try:
                    program.relative_to(example_dir)
                except ValueError as exc:
                    raise RuntimeError(f"{rel(config_path)} {case.get('name', config_path.stem)!r}: coverage program escapes example directory: {rel(program)}") from exc
                if program.parent == example_dir:
                    referenced.add(program)
                    targets.setdefault(program, []).append(CoverageCase(config_path, case))
        root_programs = {path.resolve() for path in example_dir.glob("*.tpp")}
        skipped = sorted(root_programs - referenced)
        if skipped:
            skipped_list = ", ".join(rel(path) for path in skipped)
            raise RuntimeError(f"{rel(example_dir)}: example program(s) have no shared coverage manifests: {skipped_list}")
    return [CoverageTarget(program, tuple(cases)) for program, cases in sorted(targets.items())]


def check(program: Path, configs: list[Path]) -> int:
    cases: list[CoverageCase] = []
    for config_path in configs:
        data = load_toml(config_path)
        for case in expand_cases(data):
            cases.append(CoverageCase(config_path, case))
    return check_cases(program, cases)


def check_all(examples_root: Path) -> int:
    failures = 0
    for target in discover_targets(examples_root):
        if check_cases(target.program, list(target.cases)) != 0:
            failures += 1
        print()
    return 1 if failures else 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Check .tpp rule coverage for TOML example cases")
    parser.add_argument("--all", action="store_true", help="discover and check every shared example under examples/")
    parser.add_argument("program", type=Path, nargs="?")
    parser.add_argument("configs", type=Path, nargs="*")
    args = parser.parse_args()
    if args.all:
        if args.program or args.configs:
            parser.error("--all does not accept explicit program/config arguments")
        return check_all(ROOT / "examples")
    if args.program is None or not args.configs:
        parser.error("program and at least one config are required unless --all is set")
    return check(args.program, args.configs)


if __name__ == "__main__":
    sys.exit(main())
