{
  "name": "thue",
  "displayName": "Thue++",
  "description": "Syntax highlighting, snippets, and a Run command for Thue++ programs (.thue).",
  "version": "0.1.0",
  "publisher": "thuelang",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuelang/thueplusplus.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/thuelang/thueplusplus/issues"
  },
  "homepage": "https://thuelang.org",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "thue++",
    "thue"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:thue.runFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "thue",
        "aliases": [
          "Thue++",
          "thue",
          "thue++"
        ],
        "extensions": [
          ".thue"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "thue",
        "scopeName": "source.thue",
        "path": "./syntaxes/thue.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "thue",
        "path": "./snippets/thue.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "thue.runFile",
        "title": "Run Thue++ file",
        "category": "Thue++"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "thue.runFile",
          "when": "editorLangId == thue"
        }
      ],
      "editor/title/run": [
        {
          "command": "thue.runFile",
          "when": "editorLangId == thue"
        }
      ]
    },
    "configuration": {
      "title": "Thue++",
      "properties": {
        "thue.executable": {
          "type": "string",
          "default": "thue",
          "description": "thue executable to run. A command name on PATH, or an absolute path. The extension does not install the CLI."
        },
        "thue.maxSteps": {
          "type": "integer",
          "minimum": 0,
          "default": 1000000,
          "description": "Applied rewrite limit. Run Thue++ file always passes this as --max-steps. There is no unlimited setting."
        },
        "thue.maxProbes": {
          "type": "integer",
          "minimum": 0,
          "default": 1000000,
          "description": "Rule probe limit. Run Thue++ file always passes this as --max-evals. There is no unlimited setting."
        },
        "thue.maxStateBytes": {
          "type": "integer",
          "minimum": 0,
          "default": 8388608,
          "description": "State size limit in bytes. Run Thue++ file always passes this as --max-state-bytes. There is no unlimited setting."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js && vscode-tmgrammar-snap -g ./syntaxes/thue.tmLanguage.json -s source.thue \"./tests/snap/**/*.thue\"",
    "test:update-snapshots": "vscode-tmgrammar-snap -u -g ./syntaxes/thue.tmLanguage.json -s source.thue \"./tests/snap/**/*.thue\"",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
