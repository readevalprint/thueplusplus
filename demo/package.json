    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-tsc": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
