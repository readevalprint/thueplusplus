{
  "name": "thuepp-wasm-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite --host 0.0.0.0",
    "wasm": "node scripts/build-wasm.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "build": "npm run wasm && npm run brand:assets && vue-tsc --noEmit && vite build && node scripts/prepare-dist.mjs && node scripts/check-dist.mjs",
    "test": "vue-tsc --noEmit && vitest run",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "smoke:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "thuepp": "file:../js",
    "@lucide/vue": "^1.16.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "latest",
    "@vue/tsconfig": "latest",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "monaco-editor": "^0.55.1",
    "reka-ui": "^2.9.8",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-tsc": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "tailwindcss": "^4.3.0",
    "vitest": "latest"
  }
}
