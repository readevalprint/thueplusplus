{
  "name": "thue-wasm-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/build-site.mjs",
    "summary": "node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs && npm run wasm && vite --host 0.0.0.0",
    "wasm": "node scripts/build-wasm.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "build": "node scripts/build-site.mjs && npm run wasm && npm run brand:assets && vue-tsc --noEmit && vite build && node scripts/prepare-dist.mjs && node scripts/check-dist.mjs",
    "test": "node --test scripts/site.test.mjs && node scripts/build-site.mjs && vue-tsc --noEmit && vitest run",
    "test:ui": "node scripts/build-site.mjs && vitest run",
    "test:e2e": "playwright test",
    "smoke:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@lucide/vue": "^1.59.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vitejs/plugin-vue": "latest",
    "@vue/tsconfig": "latest",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "diff": "^9.0.0",
    "monaco-editor": "^0.55.1",
    "reka-ui": "^2.11.0",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "thuelang": "file:../js",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "^4.6.4",
    "vue-tsc": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "tailwindcss": "^4.3.0",
    "vitest": "latest"
  }
}
