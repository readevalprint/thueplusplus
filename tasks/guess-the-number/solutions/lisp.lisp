(let ((lt lt) (gt gt) (secret 0) (guess 0) (live true))
  (emit "Player 1, enter the secret:\n")
  (set secret (parse (readline)))
  (while live
    (emit "Player 2, enter a guess:\n")
    (set guess (parse (readline)))
    (if (lt guess secret)
      (emit "Too low.\n")
      (if (gt guess secret)
        (emit "Too high.\n")
        (let ()
          (emit "Correct.\n")
          (set live false)))))
  (finish))
