(let ((mod mod) (eq eq) (lte lte) (add add) (n 1) (limit (parse (readline))))
  (while (lte n limit)
    (if (eq (mod n 15) 0)
      (emit "FizzBuzz")
      (if (eq (mod n 3) 0)
        (emit "Fizz")
        (if (eq (mod n 5) 0)
          (emit "Buzz")
          (emit n))))
    (emit "\n")
    (set n (add n 1)))
  (finish))
