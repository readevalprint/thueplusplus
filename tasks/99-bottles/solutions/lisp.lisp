(let ((gt gt) (eq eq) (sub sub) (n (parse (readline))) (start 0))
  (set start n)
  (while (gt n 2)
    (emit n)
    (emit " bottles of beer on the wall, ")
    (emit n)
    (emit " bottles of beer.\nTake one down and pass it around, ")
    (emit (sub n 1))
    (emit " bottles of beer on the wall.\n\n")
    (set n (sub n 1)))
  (if (eq n 2)
    (let ()
      (emit "2 bottles of beer on the wall, 2 bottles of beer.\nTake one down and pass it around, 1 bottle of beer on the wall.\n\n")
      (set n 1))
    0)
  (if (eq n 1)
    (let ()
      (emit "1 bottle of beer on the wall, 1 bottle of beer.\nTake one down and pass it around, no more bottles of beer on the wall.\n\n")
      (set n 0))
    0)
  (emit "No more bottles of beer on the wall, no more bottles of beer.\nGo to the store and buy some more, ")
  (emit start)
  (if (eq start 1)
    (emit " bottle of beer on the wall.\n")
    (emit " bottles of beer on the wall.\n"))
  (finish))
