# PEG grammar for thue++ source syntax.
# Lexical only: row trimming, comment classification, reserved operators,
# regex/template validation, and limits are semantic. Unrecognized `::` forms
# are intentionally out of spec; forks that use them define non-thue++ behavior.
# Literal `::` in source-side patterns/comments should be percent-encoded.

Language      <- SourceSection StateSection? EOF
SourceSection <- (SourceRow NL)* SourceRow?
StateSection  <- Sep StateText?
SourceRow     <- !Sep (Rule / Alias / Comment / Blank)
Sep           <- WS* '::=' WS* (NL / EOF)
StateText     <- .*
Alias        <- WS* Name WS* '<-' WS* Regex
Rule         <- LHS Mid* Op WS* RHS
Reserved     <- LHS ReservedOp RHS
Comment      <- (!ReservedOp !Op !MidOp !NL .)+

LHS          <- WS* LHSBody WS*
LHSBody      <- LHSUnit* LHSNonWS LHSUnit*
LHSUnit      <- !ReservedOp !Op !MidOp !NL .
LHSNonWS     <- !ReservedOp !Op !MidOp !WS !NL .
Regex        <- (!ReservedOp !Op !MidOp !NL .)*
Mid          <- MidOp MidBody
MidBody      <- WS* Capture '[' MidKey ']' ('=' Regex)? WS*
MidKey       <- (!']' .)+
MidOp        <- '::|'
RHS          <- (Template / !NL .)*
Template     <- '{{' Var ('|' Filter)? '}}'
Var          <- 'rule_index' / Capture
Filter       <- 'pctenc' / 'pctdec'
Capture      <- [A-Za-z_] [A-Za-z0-9_]*

Op           <- '::=' / '::<' / '::>' / '::-' / '::!'
ReservedOp   <- '::"' / '::#' / '::$' / '::%' / '::&' / '::\'' / '::(' / '::)' / '::*' / '::+' / '::,' / '::.' / '::/' / ':::' / '::;' / '::?' / '::@' / '::[' / '::\\' / '::]' / '::^' / '::_' / '::`' / '::{' / '::}' / '::~'

Name         <- [A-Z] [A-Z0-9_]*
Blank        <- WS*
WS           <- [ \t\f\v]
NL           <- '\r\n' / '\n' / '\r'
EOF          <- !.
