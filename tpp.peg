# PEG grammar for thue++ source syntax.
# Lexical only: row trimming, comment classification, reserved operators,
# regex/template validation, and limits are semantic.

Language     <- Prefix (Sep State?)? EOF
Prefix       <- (Row NL)* Row?
Row          <- !Sep (Rule / Alias / Comment)?
Sep          <- WS* '::=' WS* (NL / EOF)
State        <- (!NL .)*
Alias        <- WS* Name WS* '<-' WS* Regex
Rule         <- LHS Op RHS
Reserved     <- LHS '::' ReservedChar RHS
Comment      <- (!NL .)+

LHS          <- WS* LHSPart* LHSNonWS LHSPart* WS*
LHSPart      <- EscOp / !Op !NL .
LHSNonWS     <- EscOp / !Op !WS !NL .
EscOp        <- '\\' Op
Regex        <- (!NL .)*
RHS          <- (Template / !NL .)*
Template     <- '{{' Var ('|' Filter)? '}}'
Var          <- 'rule_index' / Capture
Filter       <- 'pctenc' / 'pctdec'
Capture      <- [A-Za-z_] [A-Za-z0-9_]*

Op           <- '::=' / '::<' / '::>' / '::-' / '::!'
ReservedChar <- ![=<>!-] [!-\/:-@[-`{-~]

Name         <- [A-Z] [A-Z0-9_]*
WS           <- [ \t]
NL           <- '\n'
EOF          <- !.
